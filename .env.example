# SSH MCP Server 环境变量配置
# 复制此文件为 .env 并填写实际值

# ── 基础连接 ──────────────────────────────────────────────────
SSH_HOST=192.168.1.100
SSH_PORT=22
SSH_USERNAME=root

# ── 认证方式（二选一）────────────────────────────────────────
# 方式1：密码认证
SSH_PASSWORD=your_password_here

# 方式2：密钥认证（优先级高于密码）
SSH_KEY_FILE=~/.ssh/id_rsa
# SSH_KEY_PASSPHRASE=key_passphrase_if_encrypted

# ── 高级选项 ──────────────────────────────────────────────────
SSH_TIMEOUT=30
# SSH_KNOWN_HOSTS_FILE=~/.ssh/known_hosts
# 跳过主机密钥检查（不推荐在生产环境使用）
# SSH_IGNORE_KNOWN_HOSTS=false

# ── 多主机配置（JSON 格式，可选）────────────────────────────
# SSH_HOSTS_JSON=[{"name":"web","host":"10.0.0.1","port":22,"username":"admin","key_file":"~/.ssh/web_key"}]
